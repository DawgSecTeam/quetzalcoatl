<ossec_config>
  <!-- Generated by quetzalcoatl edr/deploy-edr.sh. Manager: __MANAGER__ -->
  <client>
    <server>
      <address>__MANAGER__</address>
      <port>1514</port>
      <protocol>tcp</protocol>
    </server>
    <config-profile>linux,ccdc</config-profile>
    <notify_time>10</notify_time>
    <time-reconnect>30</time-reconnect>
    <auto_restart>yes</auto_restart>
    <crypto_method>aes</crypto_method>
  </client>

  <client_buffer>
    <disabled>no</disabled>
    <queue_size>5000</queue_size>
    <events_per_second>500</events_per_second>
  </client_buffer>

  <syscheck>
    <disabled>no</disabled>
    <frequency>120</frequency>
    <scan_on_start>yes</scan_on_start>
    <alert_new_files>yes</alert_new_files>
    <directories check_all="yes" report_changes="yes" realtime="yes">/etc,/bin,/sbin,/usr/bin,/usr/sbin</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/root/.ssh,/home,/etc/cron.d,/etc/cron.daily,/etc/cron.hourly,/etc/cron.weekly,/etc/cron.monthly,/etc/systemd/system,/var/spool/cron,/usr/lib/systemd/system</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/var/www,/srv/www,/usr/share/nginx/html</directories>
    <ignore>/etc/mtab</ignore>
    <ignore>/etc/random-seed</ignore>
    <ignore>/etc/adjtime</ignore>
    <ignore>/etc/ssl/certs</ignore>
    <ignore>/etc/pki</ignore>
    <ignore>/sys</ignore>
    <ignore>/proc</ignore>
    <ignore>/dev</ignore>
    <ignore>/var/log</ignore>
    <ignore type="sregex">\.log$</ignore>
    <ignore type="sregex">\.swp$</ignore>
  </syscheck>

  <rootcheck>
    <disabled>no</disabled>
    <check_files>yes</check_files>
    <check_trojans>yes</check_trojans>
    <check_dev>yes</check_dev>
    <check_sys>yes</check_sys>
    <check_pids>yes</check_pids>
    <check_ports>yes</check_ports>
    <check_if>yes</check_if>
    <frequency>43200</frequency>
    <rootkit_files>/var/ossec/etc/shared/rootkit_files.txt</rootkit_files>
    <rootkit_trojans>/var/ossec/etc/shared/rootkit_trojans.txt</rootkit_trojans>
  </rootcheck>

  <wodle name="syscollector">
    <disabled>no</disabled>
    <interval>1h</interval>
    <scan_on_start>yes</scan_on_start>
    <hardware>yes</hardware>
    <os>yes</os>
    <network>yes</network>
    <packages>yes</packages>
    <ports all="yes">yes</ports>
    <processes>yes</processes>
  </wodle>

  <localfile>
    <log_format>syslog</log_format>
    <location>__AUTHLOG__</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>__SYSLOG__</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>__KERNLOG__</location>
  </localfile>

  <localfile>
    <log_format>audit</log_format>
    <location>/var/log/audit/audit.log</location>
  </localfile>

  <localfile>
    <log_format>json</log_format>
    <location>/var/log/falco/events.json</location>
    <!-- Read from the beginning: an event written between falco start and
         logcollector start must not be skipped on a fresh deploy. -->
    <only-future-events>no</only-future-events>
  </localfile>

__WEBLOGS__

  <localfile>
    <log_format>command</log_format>
    <command>df -P</command>
  </localfile>

  <active-response>
    <!-- Alert-only by default: NCCDC permits active response, but a bad rule
         here firewalls the team off its own box. Arm selectively, never here. -->
    <disabled>yes</disabled>
  </active-response>
</ossec_config>
